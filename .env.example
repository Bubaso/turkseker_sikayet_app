# ---------------------------------------------------------------------------
# Türkşeker Müşteri Şikâyet Takip Sistemi - Ortam Değişkenleri
#
# Bu dosyayı elle kopyalamanıza gerek yok: "npm run kurulum" komutu .env.local
# dosyasını rastgele bir SESSION_SECRET ile otomatik oluşturur.
# (Windows'ta "cp" komutu bulunmadığı için kurulum betiği kullanılmalıdır.)
# ---------------------------------------------------------------------------

# Oturum çerezlerini imzalamak için kullanılır. CANLIDA MUTLAKA DEĞİŞTİRİN.
# Üretmek için: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=degistirilmesi-gereken-gelistirme-anahtari

# Veritabanı dosyasının yolu
DATABASE_PATH=./data/sikayet.db

# Yüklenen dosyaların saklanacağı dizin
UPLOAD_DIR=./data/uploads

# Demo modu: üstteki "Rol Değiştir" menüsünü ve demo girişlerini açar.
# CANLIDA "false" YAPIN.
DEMO_MODE=true

# Uygulamanın kendi adresi (SMS'lerdeki takip linki için)
APP_BASE_URL=http://localhost:3000

# --- SMS Sağlayıcısı -------------------------------------------------------
# simulasyon | netgsm | iletimerkezi
SMS_PROVIDER=simulasyon
SMS_SENDER_TITLE=TURKSEKER
NETGSM_USERNAME=
NETGSM_PASSWORD=
ILETIMERKEZI_KEY=
ILETIMERKEZI_HASH=

# --- E-posta Sağlayıcısı ---------------------------------------------------
# simulasyon | smtp
MAIL_PROVIDER=simulasyon
MAIL_FROM=sikayet@turkseker.gov.tr
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
